-- Active (open) recommendations with a resolved project_id and optional owner.
-- Shared foundation for savings reporting, owner digests, and anomaly-alert enrichment.
config {
  disabled: dataform.projectConfig.vars.enable_recommendations === "false",
  type: "view",
  name: "vw_active_recommendations",
  description: "ACTIVE recommendations from the latest Recommender export snapshot, with project_id resolved from billing data and optional owner/department.",
  columns: {
    project_id: "Project ID resolved via billing data (falls back to the project segment of target_resources)",
    owner_email: "From recommendations_owner_mapping_table (NULL if not configured or unmapped)",
    estimated_monthly_savings: "Google's projected savings normalized to a 30-day month (positive = savings)"
  }
}

js {
  // Optional owner enrichment: blank/missing var = no join
  const ownerTable = dataform.projectConfig.vars.recommendations_owner_mapping_table || "";
  const ownerColumns = ownerTable
    ? "o.owner_email, o.department_name,"
    : "CAST(NULL AS STRING) AS owner_email, CAST(NULL AS STRING) AS department_name,";
  const ownerJoin = ownerTable
    ? "LEFT JOIN `" + ownerTable + "` AS o ON o.project_id = COALESCE(m.project_id, r.PROJECT)"
    : "";
}

WITH project_map AS (
  -- Project number -> project id/name, from billing data the toolkit already loads
  SELECT
    project.number AS project_number,
    ANY_VALUE(project.id) AS project_id,
    ANY_VALUE(project.name) AS project_name
  FROM ${ref(dataform.projectConfig.vars.dest_table_name)}
  WHERE usage_start_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 90 DAY)
    AND project.number IS NOT NULL
  GROUP BY 1
)
SELECT
  COALESCE(m.project_id, r.PROJECT) AS project_id,
  COALESCE(m.project_name, r.PROJECT) AS project_name,
  ${ownerColumns}
  r.* EXCEPT (PROJECT)
FROM ${ref("gcp_billing_recommendations")} AS r
LEFT JOIN project_map AS m
  ON m.project_number = r.project_number
${ownerJoin}
WHERE r.state = 'ACTIVE'
